# 실제 비밀값은 .env에 생성하며 공개키 외 JWT 키 파일은 가져오지 않습니다.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8084
DB_URL=jdbc:postgresql://localhost:5433/payment
DB_USERNAME=payment
DB_PASSWORD=replace-with-generated-local-secret
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=stockdrop-api
ACCOUNT_JWKS_URI=http://localhost:8080/.well-known/jwks.json
EUREKA_CLIENT_ENABLED=true
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
SERVICE_INSTANCE_ID=local-8084

# 같은 종류의 테스트 클라이언트/시크릿 키만 사용합니다. 실제 값은 .env에만 둡니다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
PAYMENT_TOSS_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
PAYMENT_CONSUMER_GROUP=payment-command-v1
PAYMENT_MESSAGING_ENABLED=false
PAYMENT_PROCESSING_ENABLED=false
PAYMENT_OUTBOX_PUBLISHER_ENABLED=false

# Account 탈퇴 내부 호출의 공개 주체 UUID입니다. 네 서비스에 같은 값을 설정합니다.
ACCOUNT_WITHDRAWAL_SUBJECT=

# Monitoring의 scripts/Initialize-LocalMonitoring.ps1에서 로컬 수집 토큰을 동기화합니다.
MONITORING_SCRAPE_TOKEN=
MONITORING_OUTBOX_ENABLED=false
